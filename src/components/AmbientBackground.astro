---
---

<div class="ambient-background" aria-hidden="true">
  <!-- Subtle grid pattern -->
  <div class="bg-grid"></div>

  <!-- Animated atmospheric color blooms -->
  <div class="glow-orb orb-primary"></div>
  <div class="glow-orb orb-deep"></div>
  <div class="glow-orb orb-accent"></div>

  <!-- Micro particle dot matrix -->
  <div class="bg-dots"></div>

  <!-- Film grain noise texture overlay -->
  <div class="bg-noise"></div>
</div>

<style>
  .ambient-background {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
    background-color: var(--bg);
  }

  /* Fine subtle technical grid */
  .bg-grid {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, #000 30%, transparent 85%);
  }

  /* Secondary matrix dots */
  .bg-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(29, 78, 216, 0.15) 1px, transparent 1px);
    background-size: 28px 28px;
    opacity: 0.45;
    mask-image: radial-gradient(ellipse 75% 60% at 50% 40%, #000 20%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 75% 60% at 50% 40%, #000 20%, transparent 80%);
  }

  /* Ambient glowing atmospheric orbs with gentle breathing float */
  .glow-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(110px);
    will-change: transform, opacity;
  }

  .orb-primary {
    top: -15%;
    left: 20%;
    width: 65vw;
    max-width: 800px;
    height: 60vh;
    max-height: 650px;
    background: radial-gradient(circle, rgba(29, 78, 216, 0.16) 0%, rgba(19, 54, 124, 0.08) 60%, transparent 80%);
    animation: drift-primary 22s ease-in-out infinite alternate;
  }

  .orb-deep {
    top: 35%;
    right: -10%;
    width: 50vw;
    max-width: 600px;
    height: 55vh;
    background: radial-gradient(circle, rgba(19, 54, 124, 0.14) 0%, rgba(29, 78, 216, 0.04) 65%, transparent 85%);
    animation: drift-deep 28s ease-in-out infinite alternate;
  }

  .orb-accent {
    bottom: -10%;
    left: 10%;
    width: 45vw;
    max-width: 500px;
    height: 45vh;
    background: radial-gradient(circle, rgba(29, 78, 216, 0.09) 0%, transparent 70%);
    animation: drift-accent 20s ease-in-out infinite alternate;
  }

  /* Film grain SVG noise overlay for organic depth */
  .bg-noise {
    position: absolute;
    inset: 0;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-size: 160px 160px;
  }

  @keyframes drift-primary {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.85;
    }
    50% {
      transform: translate3d(6%, 8%, 0) scale(1.08);
      opacity: 1;
    }
    100% {
      transform: translate3d(-4%, 4%, 0) scale(0.95);
      opacity: 0.8;
    }
  }

  @keyframes drift-deep {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
      opacity: 0.7;
    }
    50% {
      transform: translate3d(-8%, -6%, 0) scale(1.12);
      opacity: 0.95;
    }
    100% {
      transform: translate3d(4%, 5%, 0) scale(0.92);
      opacity: 0.65;
    }
  }

  @keyframes drift-accent {
    0% {
      transform: translate3d(0, 0, 0) scale(0.95);
    }
    100% {
      transform: translate3d(8%, -6%, 0) scale(1.05);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .glow-orb {
      animation: none !important;
    }
  }
</style>
