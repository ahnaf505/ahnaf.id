---
const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 backdrop-blur-md bg-[#0a0a0f]/80">
  <nav class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="text-sm font-semibold tracking-wider text-white hover:text-violet-400 transition-colors">
      ahnaf<span class="text-violet-500">.id</span>
    </a>
    <div class="flex items-center gap-8">
      {links.map(link => (
        <a
          href={link.href}
          class="text-sm text-slate-400 hover:text-white transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
    </div>
  </nav>
</header>
