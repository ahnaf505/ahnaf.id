---
const projects = [
  {
    name: "DIGITS IDOR Bug POC",
    desc: "Proof-of-concept documenting a critical IDOR vulnerability in the DIGITS school registration platform that exposes confidential student documents through sequential ID enumeration.",
    stack: ["Shell", "Security Research"],
    status: "Published",
    url: "https://github.com/ahnaf505/DIGITS-Document-Leak-IDOR-Bug-POC",
  },
  {
    name: "Careless Whisper POC",
    desc: "Implementation of the silent delivery receipt RTT monitoring side-channel attack on WhatsApp, based on the Gegenhuber et al. 2025 research paper.",
    stack: ["JavaScript", "Python"],
    status: "Published",
    url: "https://github.com/ahnaf505/careless-whisper-poc",
  },
  {
    name: "WhatsLock",
    desc: "Extraction tool for WhatsApp messages via Android emulator, accessing a broader range of message data than comparable tools.",
    stack: ["Rust"],
    status: "In Progress",
    url: "https://github.com/ahnaf505/WhatsLock",
  },
  {
    name: "FaceDentify",
    desc: "Face matching engine that compares faces against databases of any size, storing metadata in TinyDB. Includes photo labeling and scalable search.",
    stack: ["Python", "OpenCV"],
    status: "Released",
    url: "https://github.com/ahnaf505/FaceDentify",
  },
  {
    name: "Teach4Learn",
    desc: "AI tutor that flips the dynamic: the model asks you to explain concepts using the Feynman Technique, identifying gaps in real time.",
    stack: ["TypeScript", "Next.js"],
    status: "Live",
    url: "https://teach4learn.com",
  },
  {
    name: "MokletCare",
    desc: "School facility incident reporting and maintenance management system built for SMK Telkom Malang. Submission for ITECHNO CUP 2026.",
    stack: ["Express.js", "PostgreSQL", "Tailwind CSS"],
    status: "Live",
    url: "https://project-lomba.vercel.app",
  },
];
---

<section id="projects" class="projects">
  <div class="projects-inner">

    <div class="section-badge">
      <span class="badge-index">02</span>
      <span class="badge-title">Selected Work</span>
    </div>

    <div class="projects-header">
      <h2 class="projects-heading">Crafted Products & Systems</h2>
      <p class="projects-sub">
        Security research, tooling, and products shipped across different stacks.
      </p>
    </div>

    <div class="project-grid">
      {projects.map(p => (
        <a href={p.url} target="_blank" rel="noopener noreferrer" class="project-card">
          <div class="project-card-top">
            <h3 class="project-name">{p.name}</h3>
            <p class="project-desc">{p.desc}</p>
          </div>
          <div class="project-card-bottom">
            <div class="project-tags">
              {p.stack.map(t => (
                <span class="project-tag">{t}</span>
              ))}
            </div>
            <span class={`project-status ${p.status === "In Progress" ? "status-wip" : ""}`}>{p.status}</span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  .projects {
    padding: 7rem 0;
    border: none;
  }

  .projects-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-bottom: 2rem;
  }

  .badge-index {
    color: var(--accent);
    font-weight: 600;
  }

  .badge-title {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .projects-header {
    margin-bottom: 3rem;
  }

  .projects-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 3.5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .projects-sub {
    font-size: 1rem;
    color: var(--muted);
    max-width: 54ch;
    margin: 0;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--surface);
    border: none;
    border-radius: 8px;
    padding: 1.75rem;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .project-card:hover {
    background: var(--surface-raised);
  }

  .project-card-top {
    margin-bottom: 1.5rem;
  }

  .project-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text);
    margin-bottom: 0.6rem;
  }

  .project-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-soft);
    margin: 0;
  }

  .project-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    background: var(--surface-raised);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }

  .project-card:hover .project-tag {
    background: var(--surface);
  }

  .project-status {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .status-wip {
    color: #f59e0b;
  }
</style>
