---
const principles = [
  {
    title: "Mechanisms Over Assumptions",
    desc: "Understanding what systems actually do under load, down to network protocols, memory bounds, and failure modes."
  },
  {
    title: "Surgical Simplicity",
    desc: "No speculative frameworks or premature abstractions. Write boring, high-performance code that remains maintainable six months out."
  },
  {
    title: "Cognitive Utility",
    desc: "Technology should sharpen human capability and comprehension rather than act as a noisy black box."
  }
];

const capabilities = [
  {
    category: "Languages",
    items: ["Rust", "Python", "TypeScript", "Go", "SQL", "Shell"]
  },
  {
    category: "Systems & Security",
    items: ["Reverse Engineering", "Protocol Analysis", "Linux Internals", "C2 & Agent Design", "Scraping Pipelines", "Cryptography"]
  },
  {
    category: "Frameworks & Tools",
    items: ["Astro", "React / Next.js", "Tailwind CSS", "FastAPI", "PostgreSQL", "Redis", "Docker"]
  }
];
---

<section id="about" class="about">
  <div class="about-inner">

    <div class="section-badge">
      <span class="badge-index">01</span>
      <span class="badge-title">Background & Approach</span>
    </div>

    <div class="about-grid">
      <div class="about-narrative">
        <h2 class="about-heading">
          Engineering focused on internals, security, and products that deliver.
        </h2>
        <div class="about-prose">
          <p>
            I am a developer based in Indonesia with an active focus on systems design, security research, and intelligent tooling. My technical intuition is grounded in looking beneath the layers, building efficient apps, and reverse engineering data flows where standard tools fall short.
          </p>
          <p>
            I build through rapid iteration, getting a working version running early and refining it based on what actually needs fixing. I focus on building efficient systems, shipping quickly, and keeping the implementation focused. Every iteration should make the system more robust while leaving the codebase simpler than before.
          </p>
        </div>

        <div class="principles-list">
          {principles.map(p => (
            <div class="principle-card">
              <h3 class="principle-title">{p.title}</h3>
              <p class="principle-desc">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="capabilities-panel">
        <h3 class="panel-header">My Working Set</h3>
        <p class="panel-sub">
          The tools I use to build reliable software, and the underlying systems I deconstruct to truly understand.
        </p>
        <div class="capabilities-list">
          {capabilities.map(group => (
            <div class="cap-group">
              <span class="cap-category">{group.category}</span>
              <ul class="cap-items">
                {group.items.map(item => (
                  <li class="cap-pill">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .about {
    padding: 7rem 0;
    border: none;
    position: relative;
  }

  .about-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-bottom: 2.25rem;
  }

  .badge-index {
    color: var(--accent);
    font-weight: 600;
  }

  .badge-title {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  .about-heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 2.35rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 1.75rem;
  }

  .about-prose {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
    color: var(--text-soft);
    font-size: 1rem;
    line-height: 1.75;
    margin-bottom: 2.75rem;
  }

  .principles-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .principle-card {
    padding: 1.25rem;
    background: var(--surface);
    border: none;
    border-radius: 6px;
  }

  .principle-title {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .principle-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }

  .capabilities-panel {
    background: var(--surface);
    border: none;
    border-radius: 8px;
    padding: 2rem;
  }

  .panel-header {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text);
    border: none;
    margin-bottom: 0.5rem;
  }

  .panel-sub {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 1.75rem;
  }

  .capabilities-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .cap-category {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--brand-primary);
    margin-bottom: 0.75rem;
  }

  .cap-items {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .cap-pill {
    display: flex;
    align-items: center;
    padding: 0.65rem 0.875rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--text);
    background: var(--surface-raised);
    border: none;
    border-radius: 6px;
  }

  .cap-pill:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
</style>
