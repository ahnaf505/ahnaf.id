---
const skills = [
  { category: "Languages", items: ["TypeScript", "Python", "Rust", "Go"] },
  { category: "Frontend", items: ["React", "Astro", "Next.js", "Tailwind CSS"] },
  { category: "Backend", items: ["Node.js", "FastAPI", "PostgreSQL", "Redis"] },
  { category: "Tooling", items: ["Docker", "Linux", "Git", "Vercel"] },
];
---

<section id="about" class="py-28 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="grid lg:grid-cols-2 gap-16 items-start">

      <!-- Left: bio -->
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-violet-400 mb-4">About</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-white mb-6 leading-snug">
          Building things that<br />
          <span class="text-slate-400">matter</span>
        </h2>
        <div class="space-y-4 text-slate-400 leading-relaxed">
          <p>
            I'm a full-stack developer with a deep curiosity for the intersection of technology and human experience.
            I care about writing clean, maintainable code — and even more about shipping products that people love to use.
          </p>
          <p>
            When I'm not coding, you'll find me reading, exploring new ideas in AI, or thinking about how software can solve real-world problems in education and beyond.
          </p>
        </div>
      </div>

      <!-- Right: skills -->
      <div class="grid grid-cols-2 gap-4">
        {skills.map(group => (
          <div class="p-5 rounded-xl border border-white/5 bg-white/[0.02] hover:border-violet-500/20 transition-colors duration-300">
            <p class="text-xs font-semibold text-violet-400 uppercase tracking-wider mb-3">{group.category}</p>
            <ul class="space-y-1.5">
              {group.items.map(item => (
                <li class="text-sm text-slate-300">{item}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
