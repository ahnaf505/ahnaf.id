---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">
  <!-- Background grid -->
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: linear-gradient(#a78bfa 1px, transparent 1px), linear-gradient(90deg, #a78bfa 1px, transparent 1px); background-size: 50px 50px;"
  ></div>

  <!-- Radial glow -->
  <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-violet-600/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-5xl mx-auto px-6 text-center">
    <!-- Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-violet-500/30 bg-violet-500/10 text-violet-300 text-xs font-medium mb-8">
      <span class="w-1.5 h-1.5 bg-violet-400 rounded-full animate-pulse"></span>
      Open to collaboration
    </div>

    <h1 class="text-5xl sm:text-7xl font-bold tracking-tight text-white mb-6 leading-tight">
      Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-violet-400 to-purple-300">Ahnaf</span>
    </h1>

    <p class="text-lg sm:text-xl text-slate-400 max-w-2xl mx-auto mb-4 leading-relaxed">
      Software engineer & builder passionate about crafting products that make a real difference.
      Currently building <span class="text-violet-300 font-medium">Teach4Learn</span> — rethinking how people learn.
    </p>

    <p class="text-sm text-slate-500 mb-12">Based in Indonesia 🇮🇩</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href="#projects"
        class="px-7 py-3 rounded-lg bg-violet-600 hover:bg-violet-500 text-white text-sm font-medium transition-all duration-200 hover:shadow-[0_0_24px_rgba(124,58,237,0.5)]"
      >
        View my work
      </a>
      <a
        href="#contact"
        class="px-7 py-3 rounded-lg border border-white/10 hover:border-white/20 text-slate-300 text-sm font-medium transition-all duration-200 hover:text-white"
      >
        Get in touch
      </a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-600 animate-bounce">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
    </svg>
  </div>
</section>
