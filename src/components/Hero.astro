---

<section class="hero">
  <div class="hero-inner">

    <div class="hero-meta">
      <span class="meta-badge">Systems & Engineering</span>
      <span class="meta-sep" aria-hidden="true">/</span>
      <span class="meta-location">Indonesia (UTC+7)</span>
    </div>

    <h1 class="hero-title">
      Hi, I am Ahnaf
    </h1>

    <p class="hero-lead">
      Software engineer building reliable systems, reverse engineering protocol internals,
      and creating focused tools designed to solve real problems without gratuitous abstraction.
    </p>

    <div class="hero-signals">
      <div class="signal-item">
        <span class="signal-label">Primary Stack</span>
        <span class="signal-val">Rust, Python, TypeScript, Go</span>
      </div>
      <div class="signal-item">
        <span class="signal-label">Focus Area</span>
        <span class="signal-val">Distributed backends, security research, applied AI</span>
      </div>
      <div class="signal-item">
        <span class="signal-label">Currently Building</span>
        <span class="signal-val">Stic.LEG (Next-Gen Adversary Emulation & C2)</span>
      </div>
    </div>

    <div class="hero-actions">
      <a href="#projects" class="btn-primary">
        Explore Work
        <span class="btn-arrow" aria-hidden="true">↓</span>
      </a>
      <a href="#about" class="btn-secondary">
        Engineering Philosophy
      </a>
      <a href="https://github.com/ahnaf505" target="_blank" rel="noopener noreferrer" class="hero-profile-pill" title="GitHub Profile">
        <svg class="pill-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span class="pill-name">GitHub</span>
        <span class="pill-handle">@ahnaf505</span>
        <svg class="pill-arrow" width="12" height="12" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4.5 11.5L11.5 4.5M11.5 4.5H6.5M11.5 4.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="#contact" class="btn-tertiary">
        Get in touch
      </a>
    </div>

  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - 3.75rem);
    display: flex;
    align-items: center;
    padding: 7.5rem 0 5rem;
    position: relative;
  }

  .hero-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }

  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-bottom: 2rem;
  }

  .meta-badge {
    color: var(--accent);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .meta-sep {
    color: var(--muted);
  }

  .meta-location {
    color: var(--muted);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 7vw, 5.25rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  .hero-lead {
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    color: var(--text-soft);
    line-height: 1.65;
    max-width: 62ch;
    margin-bottom: 3.5rem;
    font-weight: 400;
  }

  .hero-signals {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    padding: 1.75rem 0;
    border: none;
    margin-bottom: 3.5rem;
  }

  .signal-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .signal-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .signal-val {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.4;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--brand-primary);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-primary:hover {
    background: var(--brand-hover);
    box-shadow: 0 4px 20px rgba(29, 78, 216, 0.4);
  }

  .btn-arrow {
    transition: transform 0.15s ease;
  }
  .btn-primary:hover .btn-arrow {
    transform: translateY(2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border-strong);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 6px;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .btn-secondary:hover {
    background: var(--surface-raised);
    border-color: var(--accent);
    color: #fff;
  }

  /* Profile Pill in Actions */
  .hero-profile-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.15rem;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    color: var(--text-soft);
    text-decoration: none;
    font-size: 0.875rem;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .hero-profile-pill:hover {
    background: var(--surface-raised);
    border-color: rgba(96, 165, 250, 0.4);
    color: #ffffff;
    transform: translateY(-1px);
  }

  .pill-icon {
    color: #93c5fd;
  }

  .pill-name {
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .pill-handle {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .pill-arrow {
    color: var(--muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .hero-profile-pill:hover .pill-arrow {
    color: #60a5fa;
    transform: translate(1px, -1px);
  }

  .btn-tertiary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1rem;
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .btn-tertiary:hover {
    color: var(--text);
  }

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible,
  .hero-profile-pill:focus-visible,
  .btn-tertiary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 6rem 0 4rem;
    }
    .hero-signals {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    .btn-primary, .btn-secondary, .hero-profile-pill, .btn-tertiary {
      justify-content: center;
      text-align: center;
    }
  }
</style>
