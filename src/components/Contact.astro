---
---

<section id="contact" class="contact">
  <div class="contact-inner">

    <div class="section-badge">
      <span class="badge-index">03</span>
      <span class="badge-title">Get in Touch</span>
    </div>

    <div class="contact-layout">
      <div class="contact-header">
        <h2 class="contact-heading">Contact Me</h2>
        <p class="contact-sub">
          Have an interesting project, engineering challenge, or just want to discuss ideas?
          My inbox is always open.
        </p>
      </div>

      <!-- Clean, unboxed primary email link with preserved typography -->
      <div class="email-display-wrap">
        <a href="mailto:ahnaf@ahnaf.id" class="email-address-link" title="Send email to ahnaf@ahnaf.id">
          <span class="email-text">ahnaf@ahnaf.id</span>
          <svg class="email-arrow" width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M7 17L17 7M17 7H9M17 7V15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Secondary profiles -->
      <div class="network-bar">
        <span class="network-label">Connected Profiles</span>
        <div class="network-links">
          <a href="https://github.com/ahnaf505" target="_blank" rel="noopener noreferrer" class="network-item">
            <svg class="network-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span class="network-name">GitHub</span>
            <span class="network-handle">@ahnaf505</span>
            <svg class="network-arrow" width="14" height="14" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4.5 11.5L11.5 4.5M11.5 4.5H6.5M11.5 4.5V9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .contact {
    padding: 7rem 0 8.5rem;
    position: relative;
    border: none;
  }

  .contact-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-bottom: 2rem;
  }

  .badge-index {
    color: var(--accent);
    font-weight: 600;
  }

  .badge-title {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .contact-header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    margin: 0;
  }

  .contact-sub {
    font-size: 1.05rem;
    color: var(--text-soft);
    max-width: 52ch;
    line-height: 1.65;
    margin: 0;
  }

  /* Unboxed pure email link */
  .email-display-wrap {
    display: flex;
    align-items: center;
    padding: 0.5rem 0;
  }

  .email-address-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    width: fit-content;
    transition: transform 0.15s ease;
  }

  .email-text {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #ffffff;
    transition: color 0.15s ease, text-shadow 0.15s ease;
  }

  .email-arrow {
    color: var(--muted);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .email-address-link:hover .email-text {
    color: #93c5fd;
    text-shadow: 0 0 28px rgba(59, 130, 246, 0.45);
  }

  .email-address-link:hover .email-arrow {
    color: #60a5fa;
    transform: translate(3px, -3px);
  }

  /* Secondary Profiles Bar */
  .network-bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  .network-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .network-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .network-item {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.65rem 1.1rem;
    background: transparent;
    border: none;
    border-radius: 8px;
    color: var(--text-soft);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .network-item:hover {
    color: #ffffff;
    transform: translateY(-1px);
  }

  .network-icon {
    color: #93c5fd;
  }

  .network-name {
    font-family: var(--font-heading);
    font-weight: 600;
  }

  .network-handle {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .network-arrow {
    color: var(--muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .network-item:hover .network-arrow {
    color: #60a5fa;
    transform: translate(1px, -1px);
  }

  .email-address-link:focus-visible,
  .network-item:focus-visible {
    outline: 2px solid #3b82f6;
    outline-offset: 4px;
    border-radius: 4px;
  }

  @media (max-width: 720px) {
    .network-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
  }
</style>
