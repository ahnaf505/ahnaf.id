---
---

<section id="contact" class="contact">
  <div class="contact-inner">

    <div class="section-badge">
      <span class="badge-index">03</span>
      <span class="badge-title">Get in Touch</span>
    </div>

    <div class="contact-layout">
      <div class="contact-header">
        <h2 class="contact-heading">Contact Me</h2>
        <p class="contact-sub">
          Have an interesting project, engineering challenge, or just want to discuss ideas?
          My inbox is always open.
        </p>
      </div>

      <!-- Prominent featured email hero card -->
      <a href="mailto:ahnaf@ahnaf.id" class="email-hero-card">
        <div class="email-card-content">
          <div class="email-badge">
            <span class="pulse-ring" aria-hidden="true"></span>
            Direct Inquiries
          </div>
          <span class="email-address">ahnaf@ahnaf.id</span>
          <p class="email-note">Click to send an email — I usually respond within 24 hours.</p>
        </div>
        <div class="email-action-pill">
          <span>Compose Email</span>
          <span class="action-arrow" aria-hidden="true">↗</span>
        </div>
      </a>

      <!-- Secondary channels row -->
      <div class="secondary-channels">
        <span class="secondary-title">Also find me on:</span>
        <div class="channels-links">
          <a href="https://github.com/ahnaf505" target="_blank" rel="noopener noreferrer" class="channel-pill">
            <span class="channel-icon" aria-hidden="true">⌥</span>
            <span>GitHub (ahnaf505)</span>
            <span class="pill-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .contact {
    padding: 7rem 0 8rem;
    border: none;
  }

  .contact-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-bottom: 2rem;
  }

  .badge-index {
    color: var(--accent);
    font-weight: 600;
  }

  .badge-title {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact-heading {
    font-family: var(--font-heading);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .contact-sub {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 52ch;
    line-height: 1.65;
    margin: 0;
  }

  /* Prominent Email Card */
  .email-hero-card {
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-raised) 100%);
    border-radius: 12px;
    padding: 2.5rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .email-hero-card:hover {
    transform: translateY(-3px);
    background: linear-gradient(135deg, var(--surface-raised) 0%, #171b28 100%);
    box-shadow: 0 12px 35px rgba(19, 54, 124, 0.35);
  }

  .email-card-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .email-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #60a5fa;
    font-weight: 600;
  }

  .pulse-ring {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--brand-primary);
    box-shadow: 0 0 10px rgba(96, 165, 250, 0.8);
  }

  .email-address {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.2vw, 2.35rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    color: var(--text);
    transition: color 0.15s ease;
  }

  .email-hero-card:hover .email-address {
    color: #ffffff;
  }

  .email-note {
    font-size: 0.875rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }

  .email-action-pill {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.45rem;
    background: var(--brand-primary);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 8px;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .email-hero-card:hover .email-action-pill {
    background: var(--brand-hover);
    transform: scale(1.02);
  }

  .action-arrow {
    font-family: var(--font-mono);
    font-size: 1rem;
    transition: transform 0.15s ease;
  }

  .email-hero-card:hover .action-arrow {
    transform: translate(2px, -2px);
  }

  /* Secondary Channels */
  .secondary-channels {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
  }

  .secondary-title {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .channels-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .channel-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1rem;
    background: var(--surface);
    color: var(--text-soft);
    font-size: 0.825rem;
    font-family: var(--font-mono);
    text-decoration: none;
    border-radius: 6px;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .channel-pill:hover {
    background: var(--surface-raised);
    color: #ffffff;
  }

  .channel-icon {
    color: #60a5fa;
  }

  .pill-arrow {
    color: var(--muted);
    font-size: 0.85rem;
    transition: transform 0.15s ease, color 0.15s ease;
  }

  .channel-pill:hover .pill-arrow {
    color: #60a5fa;
    transform: translate(1px, -1px);
  }

  .email-hero-card:focus-visible,
  .channel-pill:focus-visible {
    outline: 2px solid var(--brand-primary);
    outline-offset: 3px;
  }

  @media (max-width: 680px) {
    .email-hero-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.75rem;
    }
    .email-action-pill {
      width: 100%;
      justify-content: center;
    }
  }
</style>
