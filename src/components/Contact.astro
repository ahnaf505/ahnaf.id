---
const channels = [
  {
    name: "Email",
    value: "ahnaf@ahnaf.id",
    href: "mailto:ahnaf@ahnaf.id",
    desc: "Direct communication for projects, consulting, or technical inquiries."
  },
  {
    name: "GitHub",
    value: "github.com/ahnaf505",
    href: "https://github.com/ahnaf505",
    desc: "Code repositories, experiments, open-source utilities."
  }
];
---

<section id="contact" class="contact">
  <div class="contact-inner">

    <div class="section-badge">
      <span class="badge-index">03</span>
      <span class="badge-title">Direct Inquiries</span>
    </div>

    <div class="contact-layout">
      <div class="contact-header">
        <h2 class="contact-heading">Initiate Contact</h2>
        <p class="contact-sub">
          Available for technical consulting, architecture reviews, and high-impact software engineering roles.
        </p>
      </div>

      <div class="channels-grid">
        {channels.map(c => (
          <a href={c.href} target={c.href.startsWith('mailto') ? undefined : "_blank"} rel="noopener noreferrer" class="channel-card">
            <div class="channel-top">
              <span class="channel-name">{c.name}</span>
              <span class="channel-arrow" aria-hidden="true">↗</span>
            </div>
            <span class="channel-value">{c.value}</span>
            <p class="channel-desc">{c.desc}</p>
          </a>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .contact {
    padding: 7rem 0;
    border: none;
  }

  .contact-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    margin-bottom: 2rem;
  }

  .badge-index {
    color: var(--accent);
    font-weight: 600;
  }

  .badge-title {
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .contact-heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 0.75rem;
  }

  .contact-sub {
    font-size: 1rem;
    color: var(--muted);
    max-width: 52ch;
    line-height: 1.65;
    margin: 0;
  }

  .channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .channel-card {
    background: var(--surface);
    border: none;
    border-radius: 8px;
    padding: 1.75rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: transform 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
  }

  .channel-card:hover {
    transform: translateY(-2px);
    background: var(--surface-raised);
    box-shadow: 0 4px 20px rgba(19, 54, 124, 0.25);
  }

  .channel-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .channel-name {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #60a5fa;
    font-weight: 600;

  .channel-arrow {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--muted);
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .channel-card:hover .channel-arrow {
    color: #60a5fa;
    transform: translate(2px, -2px);
  }

  .channel-value {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.5rem;
    word-break: break-all;
  }

  .channel-desc {
    font-size: 0.825rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
    margin-top: auto;
  }

  .channel-card:focus-visible {
    outline: 2px solid var(--brand-primary);
    outline-offset: 3px;
  }
</style>
