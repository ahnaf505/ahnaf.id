<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-left">
      <span class="footer-copy">© {new Date().getFullYear()} Ahnaf</span>
    </div>
    <div class="footer-right">
      <a href="#about" class="footer-top">Back to top ↑</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border: none;
    padding: 2.5rem 0;
    background: var(--bg);
  }

  .footer-inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .footer-copy {
    color: var(--text-soft);
    font-weight: 500;
  }


  .footer-right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }


  .footer-top {
    color: var(--text-soft);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .footer-top:hover {
    color: var(--accent);
  }

  .footer-top:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-right {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
